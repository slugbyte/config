#!/bin/bash
# window-screenshot - Take a screenshot with area selection and notification
#
# Interactive screenshot tool for Hyprland. Freezes screen, allows
# region selection with slurp, captures with grim, copies to clipboard,
# and saves to file. Clicking on a window captures that window. Shows
# a notification with an "Open in Krita" action by default.
#
# Usage:
#   window-screenshot [--no-notify] [label]
#
# Examples:
#   window-screenshot                # saves as screenshot-20240115-143022.png and notifies
#   window-screenshot --no-notify    # silent capture, no notification
#   window-screenshot bugfix         # saves as screenshot-20240115-143022-bugfix.png
#   window-screenshot "ui update"    # spaces converted to dashes

[[ "$1" == "--describe" ]] && echo "Take screenshot with interactive area selection and notification" && exit 0

if [[ "$1" == "--help" ]]; then
    echo "Usage: window-screenshot [--no-notify] [label]"
    echo ""
    echo "Take screenshot with interactive area selection."
    echo "  --no-notify   Suppress the notification"
    echo "  label         Optional suffix for filename"
    echo ""
    echo "Output: \$OMARCHY_SCREENSHOT_DIR, \$XDG_PICTURES_DIR, or \$HOME/Pictures (screenshot-*.png)"
    echo "Also copies to clipboard and symlinks to 'last'."
    echo "Clicking the notification opens the result in Krita."
    exit 0
fi

NOTIFY=1
if [[ "$1" == "--no-notify" ]]; then
    NOTIFY=0
    shift
fi

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${OMARCHY_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"

if [[ ! -d "$OUTPUT_DIR" ]]; then
  echo "window-screenshot: output directory does not exist: $OUTPUT_DIR" >&2
  if (( NOTIFY )); then
    notify-send "Screenshot directory does not exist: $OUTPUT_DIR" -u critical -t 3000
  fi
  exit 1
fi

pkill slurp && exit 0

get_rectangles() {
  local active_workspace=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .activeWorkspace.id')
  hyprctl monitors -j | jq -r --arg ws "$active_workspace" '.[] | select(.activeWorkspace.id == ($ws | tonumber)) | "\(.x),\(.y) \((if .transform % 2 == 1 then .height else .width end / .scale) | floor)x\((if .transform % 2 == 1 then .width else .height end / .scale) | floor)"'
  hyprctl clients -j | jq -r --arg ws "$active_workspace" '.[] | select(.workspace.id == ($ws | tonumber)) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
}

RECTS=$(get_rectangles)
# TODO: add wayfreeze back once it supports rotated monitors (transform != 0).
# wayfreeze 0.1.0 ignores Wayland output transforms, so the frozen overlay
# appears upside-down/rotated on monitors with a non-zero transform value.
# The fix was merged upstream (PR #24) but hasn't landed in a release yet.
# See: https://github.com/Jappie3/wayfreeze
SELECTION=$(echo "$RECTS" | slurp 2>/dev/null)

# If the selection area is L * W < 20, assume the user clicked inside a
# window/output rather than dragged a tiny region; expand to that container
# to prevent accidental 2px snapshots.
if [[ "$SELECTION" =~ ^([0-9]+),([0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]]; then
  if (( ${BASH_REMATCH[3]} * ${BASH_REMATCH[4]} < 20 )); then
    click_x="${BASH_REMATCH[1]}"
    click_y="${BASH_REMATCH[2]}"

    while IFS= read -r rect; do
      if [[ "$rect" =~ ^([0-9]+),([0-9]+)[[:space:]]([0-9]+)x([0-9]+) ]]; then
        rect_x="${BASH_REMATCH[1]}"
        rect_y="${BASH_REMATCH[2]}"
        rect_width="${BASH_REMATCH[3]}"
        rect_height="${BASH_REMATCH[4]}"

        if (( click_x >= rect_x && click_x < rect_x+rect_width && click_y >= rect_y && click_y < rect_y+rect_height )); then
          SELECTION="${rect_x},${rect_y} ${rect_width}x${rect_height}"
          break
        fi
      fi
    done <<< "$RECTS"
  fi
fi

[ -z "$SELECTION" ] && exit 0

SCREENSHOT_PATH="$OUTPUT_DIR/screenshot-$(date +'%Y%m%d-%H%M%S')${1:+"-${1//[_ ]/-}"}.png"

grim -g "$SELECTION" "$SCREENSHOT_PATH"
wl-copy < "$SCREENSHOT_PATH"

ln -sf "$SCREENSHOT_PATH" "$OUTPUT_DIR/last"

echo "$SCREENSHOT_PATH"

if (( NOTIFY )); then
  action=$(timeout 2 notify-send "Screenshot taken" "$SCREENSHOT_PATH" \
    --action="default=Open in Krita" \
    --icon="$SCREENSHOT_PATH" \
    --expire-time=2000 \
    --wait)

  if [[ "$action" == "default" ]]; then
    krita "$SCREENSHOT_PATH"
  fi
fi
